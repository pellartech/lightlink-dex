# LightLink DEX Environment Variables
# Copy this to .env.local and fill in values

# Required - but can be dummy values since we use LightLink RPC directly
REACT_APP_INFURA_KEY=dummy-key
REACT_APP_QUICKNODE_MAINNET_RPC_URL=https://eth.llamarpc.com
REACT_APP_BNB_RPC_URL=https://bsc-dataseed.binance.org

# LightLink Trading API
REACT_APP_UNISWAP_API_URL=https://uniswap-api-production-64b8.up.railway.app

# Disabled/neutralized third-party services
REACT_APP_AMPLITUDE_PROXY_URL=
REACT_APP_SENTRY_DSN=
REACT_APP_STATSIG_PROXY_URL=

# AWS API (can be disabled)
REACT_APP_AWS_API_REGION=us-east-2
REACT_APP_AWS_API_ENDPOINT=

# WalletConnect
REACT_APP_WALLET_CONNECT_PROJECT_ID=c6c9bacd35afa3eb9e6cccf6d8464395

# MoonPay (disabled)
REACT_APP_MOONPAY_API=
REACT_APP_MOONPAY_LINK=
REACT_APP_MOONPAY_PUBLISHABLE_KEY=

REACT_APP_TEMP_API_URL=
